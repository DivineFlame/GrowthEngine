# GrowthEngine Dokploy Environment Configuration
# Copy this file to .env.dokploy and fill in your actual values
# NEVER commit .env.dokploy to version control

# ============================================
# PostgreSQL Configuration
# ============================================
POSTGRES_USER=orgcomms
# Generate with: openssl rand -base64 48
POSTGRES_PASSWORD=YOUR_STRONG_POSTGRES_PASSWORD_HERE
POSTGRES_DB=orgcomms_prod

# ============================================
# Redis Configuration
# ============================================
# Generate with: openssl rand -base64 48
REDIS_PASSWORD=YOUR_STRONG_REDIS_PASSWORD_HERE

# ============================================
# JWT & Encryption Keys (Node.js Services)
# ============================================
# Generate with: openssl rand -base64 64
JWT_SECRET=YOUR_JWT_SECRET_KEY_HERE
# Generate with: openssl rand -base64 32
ENCRYPTION_KEY=YOUR_ENCRYPTION_KEY_HERE

# ============================================
# Third-Party API Keys
# ============================================
# Sarvam AI API Key (for voice/AI features)
SARVAM_API_KEY=your_sarvam_api_key_here

# Optional: Sendgrid Email Service
EMAIL_SERVICE=sendgrid
SENDGRID_API_KEY=your_sendgrid_api_key_here

# Optional: AWS S3 for recordings/media storage
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
S3_BUCKET=growthengine-media

# ============================================
# Application URLs (for CORS, redirects)
# ============================================
API_DOMAIN=api.yourdomain.com
APP_DOMAIN=app.yourdomain.com
WEBHOOK_DOMAIN=webhook.yourdomain.com

# ============================================
# Logging & Monitoring
# ============================================
LOG_LEVEL=info
# Options: debug, info, warn, error

# Optional: New Relic APM
NEW_RELIC_ENABLED=false
NEW_RELIC_LICENSE_KEY=your_new_relic_key_here

# Optional: Datadog APM
DATADOG_ENABLED=false
DATADOG_API_KEY=your_datadog_key_here
DATADOG_SITE=datadoghq.com

# ============================================
# Email Configuration (SMTP)
# ============================================
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASSWORD=${SENDGRID_API_KEY}
SMTP_FROM=noreply@yourdomain.com

# ============================================
# Paperclip (Media Transformation) Settings
# ============================================
PAPERCLIP_MAX_VIDEO_SIZE_MB=1024
PAPERCLIP_MAX_IMAGE_SIZE_MB=100
PAPERCLIP_FFMPEG_THREADS=4
PAPERCLIP_OUTPUT_QUALITY=85

# ============================================
# Hermes Publisher Settings
# ============================================
HERMES_MODE=premium_multiagent
HERMES_MAX_AGENTS=6
HERMES_APPROVAL_REQUIRED=true

# ============================================
# CSV Handler Settings
# ============================================
CSV_MAX_ROWS=5000
CSV_MAX_SIZE_MB=10
CSV_DEDUP_EMAIL=true
CSV_DEDUP_PHONE=true

# ============================================
# Database Backup Configuration
# ============================================
BACKUP_ENABLED=true
BACKUP_FREQUENCY=daily
BACKUP_TIME=02:00
BACKUP_RETENTION_DAYS=30
BACKUP_DESTINATION=local
# Options: local, s3, gcs (Google Cloud Storage)

# ============================================
# Security Settings
# ============================================
ALLOWED_ORIGINS=https://app.yourdomain.com,https://api.yourdomain.com
CORS_CREDENTIALS=true
RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# ============================================
# Feature Flags
# ============================================
FEATURE_PREMIUM_MULTIAGENT=true
FEATURE_HERMES_PUBLISHER=true
FEATURE_CSV_IMPORT=true
FEATURE_CONTENT_APPROVAL=true

# ============================================
# Database Connection Pool Settings
# ============================================
DB_POOL_MIN=5
DB_POOL_MAX=20
DB_IDLE_TIMEOUT=30000
DB_CONNECTION_TIMEOUT=5000

# ============================================
# Redis Settings
# ============================================
REDIS_POOL_SIZE=10
REDIS_RECONNECT_DELAY=500

# ============================================
# File Upload Settings
# ============================================
UPLOAD_TEMP_DIR=/tmp/uploads
MAX_FILE_SIZE_BYTES=104857600
ALLOWED_FILE_TYPES=.mp4,.mov,.avi,.wav,.mp3,.jpg,.png,.gif,.xlsx,.csv

# ============================================
# Compliance & Audit
# ============================================
AUDIT_ENABLED=true
AUDIT_LOG_RETENTION_DAYS=365
AUDIT_WEBHOOK_URL=

# ============================================
# Performance Tuning
# ============================================
NODE_ENV=production
NODE_OPTIONS=--max-old-space-size=1536

# ============================================
# Debug Mode (use only in staging)
# ============================================
DEBUG=false
VERBOSE_LOGGING=false
